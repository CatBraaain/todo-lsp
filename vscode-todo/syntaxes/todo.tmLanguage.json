{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "text.todo",
  "patterns": [{ "include": "#main" }],
  "repository": {
    "main": {
      "patterns": [
        {
          "comment": "Heading line: a colon-terminated line at indent 0+",
          "match": "^(\\s*)([^:\\n]+?):\\s*$",
          "name": "entity.name.section.todo"
        },
        { "match": "#.*$", "name": "comment.line.number-sign.todo" },
        {
          "comment": "Tag with optional parenthesized argument",
          "match": "@[A-Za-z][\\w-]*(?:\\([^)]*\\))?",
          "name": "string.tag.todo",
          "captures": {}
        }
      ]
    }
  }
}
