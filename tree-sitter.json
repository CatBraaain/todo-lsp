{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "todo",
      "camelcase": "Todo",
      "title": "Todo",
      "scope": "source.todo",
      "file-types": ["todo"],
      "injection-regex": "^todo$",
      "class-name": "TreeSitterTodo"
    }
  ],
  "metadata": {
    "version": "0.0.0",
    "license": "MIT",
    "description": "Todo grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-todo"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
