{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "todo",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_newline"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "heading_block"
              },
              {
                "type": "SYMBOL",
                "name": "task_line"
              }
            ]
          }
        }
      ]
    },
    "heading_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "heading_line"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "indent"
                },
                {
                  "type": "SYMBOL",
                  "name": "task_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "dedent"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "heading_line": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "PREC_LEFT",
        "value": 0,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "text",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "text"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            },
            {
              "type": "SYMBOL",
              "name": "colon"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "tag"
              }
            },
            {
              "type": "SYMBOL",
              "name": "_newline"
            }
          ]
        }
      }
    },
    "colon": {
      "type": "STRING",
      "value": ":"
    },
    "task_block": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "heading_block"
          },
          {
            "type": "SYMBOL",
            "name": "task_line"
          }
        ]
      }
    },
    "task_line": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "PREC_LEFT",
        "value": 0,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "FIELD",
                      "name": "text",
                      "content": {
                        "type": "SYMBOL",
                        "name": "text"
                      }
                    },
                    {
                      "type": "REPEAT",
                      "content": {
                        "type": "SYMBOL",
                        "name": "tag"
                      }
                    }
                  ]
                },
                {
                  "type": "REPEAT1",
                  "content": {
                    "type": "SYMBOL",
                    "name": "tag"
                  }
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "_newline"
            }
          ]
        }
      }
    },
    "tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "arg",
              "content": {
                "type": "SYMBOL",
                "name": "arg"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s(]+"
      }
    },
    "arg": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "PATTERN",
            "value": "[^)]*"
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_newline"
    },
    {
      "type": "SYMBOL",
      "name": "indent"
    },
    {
      "type": "SYMBOL",
      "name": "dedent"
    },
    {
      "type": "SYMBOL",
      "name": "text"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}